#include <stdio.h>
#include <stdlib.h>
#define MAX 100005  
typedef struct Queue {
    int arr[MAX];
    int front;
    int rear;
    int size;
    int capacity;
} Queue;
void initQueue(Queue *q, int capacity) {
    q->front = 0;
    q->rear = -1;
    q->size = 0;
    q->capacity = capacity;
}
void enqueue(Queue *q, int x) {
    if (q->size == q->capacity) {
        printf("Queue Overflow\n");
        return;
    }
    q->rear = (q->rear + 1) % q->capacity;
    q->arr[q->rear] = x;
    q->size++;
}
void dequeue(Queue *q) {
    if (q->size == 0) {
        printf("Queue Underflow\n");
        return;
    }
    printf("%d\n", q->arr[q->front]);
    q->front = (q->front + 1) % q->capacity;
    q->size--;
}
void peek(Queue *q) {
    if (q->size == 0) {
        printf("Queue Underflow\n");
        return;
    }
    printf("%d\n", q->arr[q->front]);
}
void display(Queue *q) {
    if (q->size == 0) {
        printf("Queue is Empty\n");
        return;
    }
    for (int i = 0; i < q->size; i++) {
        int index = (q->front + i) % q->capacity;
        printf("%d", q->arr[index]);
        if (i != q->size - 1)
            printf(" ");
    }
    printf("\n");
}
int main() {
    int N, Q;
    scanf("%d", &N);
    scanf("%d", &Q);
    Queue q;
    initQueue(&q, N);
    for (int i = 0; i < Q; i++) {
        int type, x;
        scanf("%d", &type);
        if (type == 1) { 
            scanf("%d", &x);
            enqueue(&q, x);
        } else if (type == 2) { 
            dequeue(&q);
        } else if (type == 3) {  
            peek(&q);
        } else if (type == 4) { 
            display(&q);
        }
    }
    return 0;
}
